#!/bin/sh
# The temperature, in degrees. Stands in for a sensor: a daily curve from
# the clock (18 at 02:00 UTC, 34 at 14:00), less what the vent did. The
# vent writes the time it opened to "vented"; its effect is eight degrees
# at first and fades over two hours. AVSM_NOW is the time in unix seconds
# (avsm sets it, and a simulation sets it to the simulated time).
now=${AVSM_NOW:-$(date +%s)}
vented=$(cat vented 2>/dev/null || echo 0)
awk -v now="$now" -v vented="$vented" 'BEGIN {
  m = int((now % 86400) / 60)
  d = m - 840
  if (d < 0) d = -d
  if (d > 720) d = 1440 - d
  t = 18 + 16 * (720 - d) / 720
  age = now - vented
  if (age >= 0 && age < 7200) t -= 8 * (1 - age / 7200)
  printf "%.1f\n", t
}'
